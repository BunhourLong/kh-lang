{
  "name": "kh-lang",
  "version": "0.1.0",
  "description": "Khmer word segmentation for Node.js, powered by a pure-Rust core.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BunhourLong/kh-lang.git"
  },
  "homepage": "https://github.com/BunhourLong/kh-lang#readme",
  "bugs": {
    "url": "https://github.com/BunhourLong/kh-lang/issues"
  },
  "keywords": [
    "khmer",
    "segmentation",
    "word-break",
    "tokenizer",
    "napi"
  ],
  "main": "index.js",
  "types": "index.d.ts",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "README.md",
    "LICENSE",
    "licenses"
  ],
  "napi": {
    "binaryName": "kh-lang",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc"
    ]
  },
  "scripts": {
    "build": "napi build --platform --release --no-const-enum",
    "build:debug": "napi build --platform --no-const-enum",
    "pretest": "napi build --platform --no-const-enum",
    "test": "node --test",
    "artifacts": "napi artifacts",
    "prepublishOnly": "napi prepublish -t npm --no-gh-release",
    "version": "napi version"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.12",
    "typescript": "^5.9.0"
  }
}
